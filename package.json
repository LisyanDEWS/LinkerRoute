{
	"name": "linkerroute",
	"version": "2.1.0",
	"description": "Production-ready Telegram Web proxy server",
	"type": "module",
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.18.0"
	},
	"scripts": {
		"build": "node --check src/index.js",
		"check": "npm run lint && npm test",
		"start": "node src/index.js",
		"start:single": "WORKERS=1 node src/index.js",
		"test": "node --check src/index.js",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"keywords": [
		"proxy",
		"telegram",
		"railway"
	],
	"author": "Mercury Workshop",
	"license": "GNU AGPLv3",
	"dependencies": {
		"@fastify/compress": "^9.2.0",
		"@fastify/helmet": "^13.1.1",
		"@fastify/static": "^10.1.3",
		"@mercuryworkshop/bare-mux": "^2.1.9",
		"@mercuryworkshop/libcurl-transport": "^1.5.2",
		"@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
		"@mercuryworkshop/wisp-js": "^0.5.0",
		"fastify": "^5.12.5",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"eslint": "^9.13.0",
		"prettier": "^3.3.3"
	}
}
