# Railway supplies PORT automatically. This value is for local/Docker runs.
PORT=3000
NODE_ENV=production

# One worker per allocated vCPU, capped by MAX_WORKERS. Set WORKERS=1 when
# using multiple Railway replicas or a small memory plan.
WORKERS=auto
MAX_WORKERS=8

# Keep the heap below the container limit. Set this per Railway memory plan;
# this example is a per-worker limit, not a total for the service.
NODE_OPTIONS=--max-old-space-size=512

# Railway's public ingress is a trusted reverse proxy. Use false when exposing
# the container directly without a proxy.
TRUST_PROXY=true

# HTTP/socket protection. MAX_CONNECTIONS and MAX_CONNECTIONS_PER_IP apply per
# worker; the effective service limit is multiplied by the worker count.
MAX_CONNECTIONS=1000
MAX_CONNECTIONS_PER_IP=100
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_SIZE=1mb
MAX_HEADER_SIZE=16kb
MAX_HEADERS_COUNT=100
MAX_REQUESTS_PER_SOCKET=1000
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=10000
# Keep this at zero for long-lived WebSocket connections.
SOCKET_TIMEOUT_MS=0
SHUTDOWN_TIMEOUT_MS=25000

ENABLE_COMPRESSION=true
LOG_REQUESTS=false
# Leave empty to keep /metrics disabled. Use a long random value when scraping.
METRICS_TOKEN=
# Optional comma-separated origins. Same-origin operation needs no CORS.
CORS_ORIGINS=

WISP_STREAM_LIMIT_TOTAL=100
WISP_STREAM_LIMIT_PER_HOST=50
WISP_DNS_METHOD=resolve
WISP_DNS_SERVERS=1.1.1.1,8.8.8.8
